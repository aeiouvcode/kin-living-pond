; Engine configuration file.
config_version=5

[application]
config/name="KIN"
config/description="A living koi pond. Local-first, no network."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.07, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[display]
window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/dpi/allow_hidpi=true

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.035, 0.07, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=false
